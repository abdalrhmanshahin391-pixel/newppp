SONIOX_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
RITA_TTS_PROVIDER=cartesia
# Layan; this is a voice identifier, not an API credential.
RITA_CARTESIA_VOICE_ID=64a941ac-07ac-462c-a81c-008e353dd83e
# Measured WebSocket optimum: 0 gives ~74-75 ms warm first PCM in Modal EU.
# Set 50 if a real-call review finds token-boundary pauses objectionable.
RITA_CARTESIA_MAX_BUFFER_DELAY_MS=0
RITA_CARTESIA_TRIM_ENABLED=false
RITA_CARTESIA_TRIM_RMS_FLOOR=32
RITA_CARTESIA_TRIM_PEAK_FLOOR=128
SONIOX_URL=wss://stt-rt.eu.soniox.com/transcribe-websocket
