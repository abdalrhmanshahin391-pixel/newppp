          "weight": 2
        },
        {
          "id": "answer-how",
          "text": "Answer How are you?",
          "text_ar": "يجيب على How are you?",
          "criteria": "The learner answers with a phrase like I'm fine, thank you.",
          "check_prompts": [
            "How are you today?"
