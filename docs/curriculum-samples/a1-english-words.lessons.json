        {
          "id": "goodbye",
          "text": "Say goodbye",
          "text_ar": "يودّع",
          "criteria": "The learner says goodbye / see you later / good night.",
          "check_prompts": [
            "It is late and you are going home. What do you say?"
          ],
          "weight": 1
        }
      ],
      "plan": {
        "phases": [
          {
            "phase": "warmup",
            "minutes": 1,
            "steps": [
              "Greet the learner warmly and say today's words are about greetings"
            ]
          },
          {
            "phase": "teach",
            "minutes": 2,
            "steps": [
              "Say four or five key words with their Arabic meaning",
              "Use each in a short example"
            ]
          },
          {
            "phase": "practice",
            "minutes": 3,
            "steps": [
              "Role-play a short everyday situation",
              "Swap roles so the learner starts"
            ]
          },
          {
            "phase": "check",
            "minutes": 2,
            "steps": [
              "Ask each objective's question and wait"
            ]
          },
          {
            "phase": "wrap",
            "minutes": 1,
            "steps": [
              "Praise one thing the learner did well",
              "Say one sentence that sums up the lesson"
            ]
          }
        ],
        "teacher_notes": "Keep it playful. If the learner answers in Arabic, give the English and ask them to repeat it."
