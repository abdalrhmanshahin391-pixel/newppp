      "source_to_page": 2,
      "summary": "Rita practises saying hello, asking How are you?, answering, and saying goodbye at different times of day.",
      "objectives": [
        {
          "id": "greet",
          "text": "Greet Rita and ask how she is",
          "text_ar": "يحيّي ريتا ويسأل عن حالها",
          "criteria": "The learner says a greeting (hello / hi / good morning ...) and asks How are you?",
          "check_prompts": [
